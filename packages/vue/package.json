{
  "name": "@rte/vue",
  "version": "0.0.0",
  "description": "@rte/core 的 Vue 3 适配层:组件绑定 + 命令式 API + 上传状态渲染",
  "keywords": [
    "rich-text-editor",
    "vue",
    "vue3",
    "contenteditable",
    "mobile",
    "editor"
  ],
  "license": "MIT",
  "author": "muzigo-cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzigo-cn/rich-text-editor.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/muzigo-cn/rich-text-editor/issues"
  },
  "homepage": "https://github.com/muzigo-cn/rich-text-editor#readme",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@rte/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vue": "^3.4.0"
  }
}
