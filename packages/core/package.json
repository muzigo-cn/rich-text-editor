{
  "name": "@fe-muzi/rte-core",
  "version": "0.1.1",
  "description": "移动端富文本编辑器内核:话题(#)插入 + 图片/视频图文混排,框架无关,基于 contentEditable + Selection API",
  "keywords": [
    "rich-text-editor",
    "contenteditable",
    "mobile",
    "selection",
    "topic",
    "editor"
  ],
  "license": "MIT",
  "author": "muzigo-cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzigo-cn/rich-text-editor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/muzigo-cn/rich-text-editor/issues"
  },
  "homepage": "https://github.com/muzigo-cn/rich-text-editor#readme",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles/*": "./styles/*"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^15.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
